# Elora Backend - .env.example (copie para .env e preencha)
# Nunca commitar .env com valores reais (está no .gitignore:12)
DB_HOST=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
# Produção: defina JWT_SECRET com no mínimo 32 chars (openssl rand -base64 48)
JWT_SECRET=MUDE_ME_min_32_chars
JWT_EXPIRATION=
JWT_REFRESH_EXPIRATION=
# Frontend base (para CORS)
FRONTEND_URL=http://localhost:8000
