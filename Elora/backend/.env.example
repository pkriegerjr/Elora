# Elora backend — exemplo de variáveis locais (Neon PostgreSQL).
# 1. Copie para `.env` (ignorado pelo git):  cp .env.example .env (Linux) / copy .env.example .env (Windows)
# 2. Preencha com os dados do Neon (use a connection string DIRETA, não a do pooler, para JDBC)
#    e rode:  mvn clean install  /  mvn spring-boot:run
# NUNCA commite o `.env` com valores reais.

# Banco Neon (application.properties) — sobrescrevem os defaults
DB_HOST=ep-xxx.us-east-2.aws.neon.tech
DB_NAME=neondb
DB_USERNAME=
DB_PASSWORD=

# JWT — OBRIGATÓRIO em produção (mín. 32 chars). Gere com: openssl rand -base64 48
JWT_SECRET=troque-este-valor-em-producao-com-minimo-32-caracteres
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=2592000000
