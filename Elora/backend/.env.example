# Elora backend — exemplo de variáveis locais (DEV).
# 1. Copie para `.env` (ignorado pelo git):  copy .env.example .env   (Windows) / cp .env.example .env (Linux)
# 2. Ajuste os valores e rode:  docker compose up -d  /  ./mvnw spring-boot:run
# NUNCA commite o `.env` com valores reais.

# Banco local (docker-compose.yml)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=elora_db
MYSQL_USER=elora
MYSQL_PASSWORD=elora123

# Spring (application.properties) — sobrescrevem os defaults
DB_HOST=localhost
DB_NAME=elora_db
DB_USERNAME=root
DB_PASSWORD=root

# JWT — OBRIGATÓRIO em produção (mín. 32 chars). Gere com: openssl rand -base64 48
JWT_SECRET=troque-este-valor-em-producao-com-minimo-32-caracteres
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=2592000000
