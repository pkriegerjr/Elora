# Elora backend — exemplo de variáveis locais (Neon PostgreSQL).
# 1. Copie para `.env` (ignorado pelo git):  cp .env.example .env (Linux) / copy .env.example .env (Windows)
# 2. Preencha com os dados do Neon (use a connection string DIRETA, não a do pooler, para JDBC)
#    e rode:  mvn clean install  /  mvn spring-boot:run
# NUNCA commite o `.env` com valores reais.

# Banco Neon (application.properties) — sobrescrevem os defaults
DB_HOST=ep-xxx.us-east-2.aws.neon.tech
DB_NAME=neondb
DB_USERNAME=
DB_PASSWORD=

# JWT — OBRIGATÓRIO em produção (mín. 32 chars). Gere com: openssl rand -base64 48
JWT_SECRET=troque-este-valor-em-producao-com-minimo-32-caracteres
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=2592000000

#Pagamento ASAAS
PAGAMENTO_PROVIDER=mock
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_TIMEOUT_MS=10000

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_MAX_BYTES=5242880
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PATH_STYLE=true

#Email
EMAIL_ENABLED=false
EMAIL_REMETENTE=nao-responda@elora.local
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true

#API Google Maps
WEBAPP_BASE_URL=http://localhost:8000
GOOGLE_MAPS_API_KEY=
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=12MB
ACTUATOR_ENDPOINTS=health,info
ACTUATOR_HEALTH_DETAILS=never